{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "52b3b76e7e5b493b8200c0a43ae05e09",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PixelWipeMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -756.7999877929688,
            "y": 220.8000030517578,
            "width": 240.7999267578125,
            "height": 301.60003662109377
        }
    },
    "m_Slots": [
        {
            "m_Id": "a5d28c9adb6f47ca98ac81594b61c85d"
        },
        {
            "m_Id": "bd9768413a0a4287b0d03675eca8647d"
        },
        {
            "m_Id": "cf11e15a47444d238a38169576c18948"
        }
    ],
    "synonyms": [
        "pixel",
        "wipe",
        "transition"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PixelWipeMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 cell = floor(UV * float2(64.0, 36.0));\nfloat2 p = frac(cell * float2(127.1, 311.7));\np += dot(p, p + 74.7);\nfloat noise = frac(p.x * p.y);\nfloat cellX = (cell.x + 0.5) / 64.0;\nfloat edge = 0.16;\nfloat revealTime = cellX + noise * edge;\nfloat filled = step(revealTime, saturate(Amount) * (1.0 + edge));\nOut = 1.0 - filled;"
}

